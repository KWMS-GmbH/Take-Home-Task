{
  "name": "StopTransaction arrives hours late",
  "description": "Session started 6 h ago; the stop happened 5 h ago but is only delivered now, after a reconnect.",
  "check": [
    "stop time is ~5 h ago (from the message timestamp), not 'now'",
    "duration ~1 h, energy 4.0 kWh",
    "if the session was closed as incomplete earlier, the late stop corrects it"
  ],
  "steps": [
    {
      "conn": "a",
      "open": "$station"
    },
    {
      "conn": "a",
      "call": "BootNotification",
      "payload": {
        "chargePointVendor": "ACME",
        "chargePointModel": "DC-150"
      },
      "require": [
        "status",
        "currentTime",
        "interval"
      ]
    },
    {
      "conn": "a",
      "call": "StartTransaction",
      "payload": {
        "connectorId": 1,
        "idTag": "$idtag",
        "meterStart": 2000,
        "timestamp": "$ts(-6h)"
      },
      "save": {
        "tx": "transactionId"
      },
      "require": [
        "idTagInfo"
      ],
      "expect_status": "Accepted"
    },
    {
      "conn": "a",
      "close": true
    },
    {
      "sleep": 0.3
    },
    {
      "conn": "b",
      "open": "$station"
    },
    {
      "conn": "b",
      "call": "BootNotification",
      "payload": {
        "chargePointVendor": "ACME",
        "chargePointModel": "DC-150"
      },
      "require": [
        "status",
        "currentTime",
        "interval"
      ]
    },
    {
      "conn": "b",
      "call": "StopTransaction",
      "payload": {
        "transactionId": "$tx",
        "meterStop": 6000,
        "timestamp": "$ts(-5h)",
        "reason": "Local"
      }
    },
    {
      "conn": "b",
      "close": true
    }
  ]
}

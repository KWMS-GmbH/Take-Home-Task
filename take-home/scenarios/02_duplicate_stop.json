{
  "name": "Duplicate StopTransaction after reconnect",
  "description": "The charge point resends the same StopTransaction (same uniqueId) on a new connection.",
  "check": [
    "the session is completed exactly once",
    "energy is 10.0 kWh, not doubled or overwritten",
    "no duplicate rows for the stop event"
  ],
  "steps": [
    {
      "conn": "a",
      "open": "$station"
    },
    {
      "conn": "a",
      "call": "BootNotification",
      "payload": {
        "chargePointVendor": "ACME",
        "chargePointModel": "DC-150"
      },
      "require": [
        "status",
        "currentTime",
        "interval"
      ]
    },
    {
      "conn": "a",
      "call": "StartTransaction",
      "payload": {
        "connectorId": 1,
        "idTag": "$idtag",
        "meterStart": 1000,
        "timestamp": "$ts(-60m)"
      },
      "save": {
        "tx": "transactionId"
      },
      "require": [
        "idTagInfo"
      ],
      "expect_status": "Accepted"
    },
    {
      "conn": "a",
      "call": "StopTransaction",
      "payload": {
        "transactionId": "$tx",
        "meterStop": 11000,
        "timestamp": "$ts(-5m)",
        "reason": "Local"
      },
      "id": "stop-$run-1"
    },
    {
      "conn": "a",
      "close": true
    },
    {
      "sleep": 0.3
    },
    {
      "conn": "b",
      "open": "$station"
    },
    {
      "conn": "b",
      "call": "BootNotification",
      "payload": {
        "chargePointVendor": "ACME",
        "chargePointModel": "DC-150"
      },
      "require": [
        "status",
        "currentTime",
        "interval"
      ]
    },
    {
      "conn": "b",
      "call": "StopTransaction",
      "payload": {
        "transactionId": "$tx",
        "meterStop": 11000,
        "timestamp": "$ts(-5m)",
        "reason": "Local"
      },
      "id": "stop-$run-1"
    },
    {
      "conn": "b",
      "close": true
    }
  ]
}
